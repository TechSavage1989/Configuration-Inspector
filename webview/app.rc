#include <windows.h>
1 ICON "icon.ico"
101 RCDATA "index.html"
102 RCDATA "WebView2Loader.dll"
1 RT_MANIFEST "app.manifest"

#include "version.h"
1 VERSIONINFO
 FILEVERSION CI_VERSION_RESOURCE
 PRODUCTVERSION CI_VERSION_RESOURCE
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS 0x40004L
 FILETYPE 1
 FILESUBTYPE 0
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "Config Inspector"
   VALUE "FileVersion", CI_VERSION
   VALUE "ProductName", "Config Inspector"
   VALUE "ProductVersion", CI_VERSION
   VALUE "OriginalFilename", "Config_Inspector.exe"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
